/* 우리은하 시뮬레이션 모델 */
const PC = 15000;
const GAL = (() => {
  const r = rng('milkyway-model');
  const gg = () => (r() + r() + r() + r() - 2) / 1.15;
  const pts = [];
  const add = (x,y,z,c,s) => pts.push({x,y,z,c,s});
  const barA = 0.45;
  for (let i = 0; i < 1300; i++) {
    const R = Math.abs(gg()) * 0.13, a = r() * 6.283, b = Math.acos(2 * r() - 1);
    add(R * Math.sin(b) * Math.cos(a), R * Math.sin(b) * Math.sin(a), R * Math.cos(b) * 0.75, ['#ffe2b0','#ffd08a','#fff2d8'][r()*3|0], 0.9);
  }
  for (let i = 0; i < 700; i++) {
    const u = (r() - .5) * 0.62, v = gg() * 0.045;
    add(u * Math.cos(barA) - v * Math.sin(barA), u * Math.sin(barA) + v * Math.cos(barA), gg() * 0.025, ['#ffd9a0','#ffe9c8'][r()*2|0], 0.8);
  }
  const arm = (th0, n, bright) => {
    for (let i = 0; i < n; i++) {
      const t = r() * 4.3, R = 0.3 * Math.exp(0.28 * t), a = th0 + t, sc = gg() * 0.06 * (0.5 + R);
      add(Math.cos(a)*R - Math.sin(a)*sc, Math.sin(a)*R + Math.cos(a)*sc, gg()*0.014, bright && r() < .12 ? '#ff8fb0' : ['#cfe0ff','#9fc2ff','#ffffff'][r()*3|0], bright ? 0.75 : 0.6);
    }
  };
  arm(barA, 3000, true);
  arm(barA + Math.PI, 3000, true);
  arm(barA + Math.PI/2, 1500, false);
  arm(barA + Math.PI*1.5, 1500, false);

  for (let i = 0; i < 1600; i++) {
    const R = -Math.log(1 - r() * 0.95) * 0.3, a = r() * 6.283;
    add(Math.cos(a)*R, Math.sin(a)*R, gg()*0.02, '#b9c3e6', 0.5);
  }
  const tS = Math.log((8500 / PC) / 0.3) / 0.28, aS = barA + Math.PI / 2 + tS;
  let sun = { x: Math.cos(aS) * 8500 / PC, y: Math.sin(aS) * 8500 / PC, z: 0 };
  const rot = Math.PI - Math.atan2(sun.y, sun.x), cr = Math.cos(rot), sr = Math.sin(rot);
  pts.forEach(q => {
    const x = q.x * cr - q.y * sr, y = q.x * sr + q.y * cr;
    q.x = x; q.y = y;
  });
  sun = { x: -8500 / PC, y: 0, z: 0 };

  const glob = [];
  for (let i = 0; i < 38; i++) {
    const R = 0.12 + Math.abs(gg()) * 0.5, a = r() * 6.283, b = Math.acos(2 * r() - 1);
    glob.push({ x: R * Math.sin(b) * Math.cos(a), y: R * Math.sin(b) * Math.sin(a), z: R * Math.cos(b) });
  }
  const open = [];
  for (let i = 0; i < 26; i++) {
    const q = pts[2500 + (r() * 5000 | 0)];
    open.push({ x: q.x, y: q.y, z: q.z });
  }
  return { pts, sun, glob, open, barA };
})();

function sizeCanvas(cv, ratio){
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  const w = cv.clientWidth || 600, h = Math.round(w * ratio);
  cv.style.height = h + 'px'; cv.width = w * dpr; cv.height = h * dpr;
  const c = cv.getContext('2d');
  c.setTransform(dpr, 0, 0, dpr, 0, 0);
  return { c, w, h };
}
function dot(c, x, y, rad, col, a){
  c.globalAlpha = a; c.fillStyle = col; c.beginPath(); c.arc(x, y, rad, 0, 7); c.fill(); c.globalAlpha = 1;
}
function label(c, x, y, t, col, align){
  c.font = '15px "Do Hyeon",sans-serif';
  c.textAlign = align || 'center';
  c.textBaseline = 'middle';
  c.lineWidth = 4;
  c.strokeStyle = 'rgba(3,4,10,.85)';
  c.strokeText(t, x, y);
  c.fillStyle = col || '#ebe9f7';
  c.fillText(t, x, y);
}
function drawGalaxy(cv, o){
  const { c, w, h } = sizeCanvas(cv, o.ratio || 0.75);
  c.fillStyle = '#03040a'; c.fillRect(0, 0, w, h);
  const sc = Math.min(w * 0.46, h * (o.tilt > 60 ? 0.9 : 0.46)), cx = w / 2, cy = h / 2;
  const ph = (o.tilt || 0) * Math.PI / 180, cp = Math.cos(ph), sp = Math.sin(ph);
  const P = q => [cx + q.x * sc, cy + (q.y * cp - q.z * sp) * sc];

  c.globalCompositeOperation = 'lighter';
  const al = 0.5 * (1 - 0.55 * sp);
  GAL.pts.forEach(q => {
    const [x, y] = P(q);
    dot(c, x, y, q.s * Math.max(0.7, sc / 260), q.c, al);
  });
  const g = c.createRadialGradient(cx, cy, 0, cx, cy, sc * 0.18);
  g.addColorStop(0, 'rgba(255,220,160,.55)');
  g.addColorStop(1, 'rgba(255,220,160,0)');
  c.fillStyle = g;
  c.beginPath();
  c.ellipse(cx, cy, sc * 0.18, sc * 0.18 * Math.max(cp, 0.55), 0, 0, 7);
  c.fill();
  c.globalCompositeOperation = 'source-over';

  if (o.glob) {
    GAL.glob.forEach(q => {
      const [x, y] = P(q);
      dot(c, x, y, 3.2, '#ffb46e', 1);
      c.strokeStyle = 'rgba(255,180,110,.6)'; c.beginPath(); c.arc(x, y, 6, 0, 7); c.stroke();
    });
  }
  if (o.open) {
    GAL.open.forEach(q => {
      const [x, y] = P(q);
      c.strokeStyle = '#7fb1ff'; c.lineWidth = 1.5; c.beginPath(); c.arc(x, y, 5, 0, 7); c.stroke();
    });
  }
  return { sc, cx, cy, P };
}
function sunMark(c, x, y){
  c.fillStyle = '#f2c14e'; c.strokeStyle = '#03040a'; c.lineWidth = 2; c.beginPath();
  for (let i = 0; i < 10; i++) {
    const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? 4 : 9;
    c.lineTo(x + Math.cos(a)*rr, y + Math.sin(a)*rr);
  }
  c.closePath(); c.stroke(); c.fill();
}

