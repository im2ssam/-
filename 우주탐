/* 천체 Canvas 렌더링 */
function rng(seed){
  let a = 0;
  for (const c of seed) a = (a * 31 + c.charCodeAt(0)) | 0;
  return () => {
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
const g = r => (r() + r() + r() + r() - 2) / 1.15;
function star(ctx, x, y, s, col, glow){
  if (glow) {
    const gr = ctx.createRadialGradient(x, y, 0, x, y, s * 5);
    gr.addColorStop(0, col);
    gr.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.globalAlpha = .35;
    ctx.fillStyle = gr;
    ctx.beginPath();
    ctx.arc(x, y, s * 5, 0, 7);
    ctx.fill();
    ctx.globalAlpha = 1;
  }
  ctx.fillStyle = col;
  ctx.beginPath();
  ctx.arc(x, y, s, 0, 7);
  ctx.fill();
}
function blob(ctx, x, y, r, col, a){
  const gr = ctx.createRadialGradient(x, y, 0, x, y, r);
  gr.addColorStop(0, col.replace('A', a));
  gr.addColorStop(1, col.replace('A', 0));
  ctx.fillStyle = gr;
  ctx.beginPath();
  ctx.arc(x, y, r, 0, 7);
  ctx.fill();
}

function draw(cv, o, mystery){
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  const w = cv.clientWidth || 320, h = cv.clientHeight || 180;
  cv.width = w * dpr; cv.height = h * dpr;
  const ctx = cv.getContext('2d');
  ctx.scale(dpr, dpr);
  const r = rng(o.id), cx = w / 2, cy = h / 2, U = Math.min(w, h);
  ctx.fillStyle = '#04050c';
  ctx.fillRect(0, 0, w, h);
  const field = n => { for (let i = 0; i < n; i++) star(ctx, r() * w, r() * h, r() * .8 + .2, `rgba(220,225,255,${.25 + r() * .5})`); };
  field(mystery ? 60 : 90);

  if (mystery) {
    ctx.fillStyle = 'rgba(242,193,78,.85)';
    ctx.font = `${U * .32}px "Do Hyeon",sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('?', cx, cy);
    return;
  }

  ctx.globalCompositeOperation = 'lighter';
  const t = o.type;
  if (t === 'open') {
    const n = o.id === 'pleiades' ? 14 : 40;
    if (o.id === 'pleiades') for (let i = 0; i < 40; i++) blob(ctx, cx + g(r)*U*.3, cy + g(r)*U*.22, U*(.12 + r()*.12), 'rgba(90,140,255,A)', .07);
    for (let i = 0; i < n; i++) {
      const big = r() < .25;
      let col = ['#ffffff','#cfe0ff','#9fc2ff'][r()*3|0];
      if (o.id === 'jewelbox' && i === 3) col = '#ffb070';
      star(ctx, cx + g(r)*U*.32, cy + g(r)*U*.24, big ? 1.8 + r()*1.4 : .8 + r(), col, true);
    }
  } else if (t === 'globular') {
    blob(ctx, cx, cy, U * .35, 'rgba(255,200,140,A)', .35);
    for (let i = 0; i < 2600; i++) {
      const rr = U * .42 * Math.pow(r(), 2.2), a = r() * 6.283;
      star(ctx, cx + Math.cos(a)*rr, cy + Math.sin(a)*rr, .4 + r()*.8, ['#ffe2a8','#ffc98a','#fff3d6','#ffaa66'][r()*4|0]);
    }
  } else if (t === 'emission') {
    const pts = [];
    for (let i = 0; i < 170; i++) {
      let x, y;
      if (o.id === 'rosette') { const a = r()*6.283, rad = U*(.26 + g(r)*.06); x = cx + Math.cos(a)*rad; y = cy + Math.sin(a)*rad; }
      else if (o.id === 'crescent') { const a = -1.2 + r()*3.6, rad = U*(.3 + g(r)*.03); x = cx + Math.cos(a)*rad*1.1; y = cy + Math.sin(a)*rad*.8; }
      else { x = cx + g(r)*U*.4; y = cy + g(r)*U*.22; }
      pts.push([x,y]);
    }
    pts.forEach(([x,y]) => blob(ctx, x, y, U*(.05 + r()*.1), r() < .75 ? 'rgba(255,70,105,A)' : 'rgba(255,150,120,A)', .16));
    for (let i = 0; i < 10; i++) star(ctx, cx + g(r)*U*.3, cy + g(r)*U*.2, 1 + r()*1.2, '#e6f0ff', true);
  } else if (t === 'reflection') {
    for (let i = 0; i < 120; i++) blob(ctx, cx + g(r)*U*.32, cy + g(r)*U*.22, U*(.05 + r()*.1), r() < .8 ? 'rgba(80,150,255,A)' : 'rgba(150,200,255,A)', .15);
    star(ctx, cx, cy, 3, '#ffffff', true);
    star(ctx, cx, cy, 1.6, '#ffffff', true);
    if (o.id === 'runningman') {
      ctx.globalCompositeOperation = 'source-over';
      ctx.strokeStyle = 'rgba(4,5,12,.65)'; ctx.lineCap = 'round'; ctx.lineWidth = U * .05;
      [[-.25,-.05,.0,-.02],[.0,-.02,.12,.18],[.0,-.02,.2,-.2],[-.05,.0,-.2,.2]].forEach(([a,b,c,d]) => {
        ctx.beginPath(); ctx.moveTo(cx + a*U, cy + b*U); ctx.lineTo(cx + c*U, cy + d*U); ctx.stroke();
      });
    }
  } else if (t === 'dark') {
    for (let i = 0; i < 900; i++) {
      const y = cy + g(r)*h*.25;
      star(ctx, r()*w, y, .3 + r()*.8, `rgba(255,240,220,${.3 + r()*.6})`);
    }
    if (o.id === 'horsehead') for (let i = 0; i < 90; i++) blob(ctx, r()*w, h*(.05 + r()*.45), U*(.08 + r()*.1), 'rgba(255,70,100,A)', .13);
    else for (let i = 0; i < 40; i++) blob(ctx, r()*w, cy + g(r)*h*.2, U*.15, 'rgba(255,230,200,A)', .06);
    ctx.globalCompositeOperation = 'source-over';
    const dark = (x,y,rad) => {
      const gr = ctx.createRadialGradient(x, y, rad*.4, x, y, rad);
      gr.addColorStop(0, 'rgba(3,3,8,.97)'); gr.addColorStop(1, 'rgba(3,3,8,0)');
      ctx.fillStyle = gr; ctx.beginPath(); ctx.arc(x, y, rad, 0, 7); ctx.fill();
    };
    if (o.id === 'horsehead') {
      ctx.fillStyle = 'rgba(3,3,8,.97)'; ctx.fillRect(0, h*.62, w, h);
      for (let i = 0; i < 14; i++) dark(cx + (r()-.5)*U*.12, h*.62 - i*U*.022, U*.07);
      dark(cx - U*.07, h*.62 - U*.3, U*.09); dark(cx - U*.14, h*.62 - U*.24, U*.07);
      for (let i = 0; i < 18; i++) dark(r()*w, h*.66, U*.09);
    } else {
      for (let i = 0; i < 22; i++) dark(cx + g(r)*U*.14, cy + g(r)*U*.12, U*(.1 + r()*.08));
    }
  } else if (t === 'milkyway') {
    ctx.save(); ctx.translate(cx, cy); ctx.rotate(-.35);
    for (let i = 0; i < 120; i++) blob(ctx, (r()-.5)*w*1.3, g(r)*U*.08, U*(.08 + r()*.1), r() < .7 ? 'rgba(220,200,255,A)' : 'rgba(255,200,150,A)', .09);
    for (let i = 0; i < 40; i++) blob(ctx, g(r)*U*.25, g(r)*U*.08, U*.12, 'rgba(255,215,170,A)', .12);
    for (let i = 0; i < 900; i++) star(ctx, (r()-.5)*w*1.3, g(r)*U*.12, .3 + r()*.7, 'rgba(255,250,240,.8)');
    ctx.restore(); ctx.globalCompositeOperation = 'source-over';
    for (let i = 0; i < 14; i++) {
      ctx.fillStyle = 'rgba(4,5,12,.5)'; ctx.beginPath();
      ctx.ellipse(cx + (r()-.5)*U*.6, cy + (r()-.5)*U*.12 + (r()-.5)*20, U*.12, U*.015, -.35, 0, 7);
      ctx.fill();
    }
  }
  ctx.globalCompositeOperation = 'source-over';
}

