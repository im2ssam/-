  gOpened.g4 = gOpened.g4 || Date.now();
  b.innerHTML = `<div class="gpair"><div><canvas class="gcv" id="cv4"></canvas><div class="cap">지구의 공전 궤도와 밤하늘 시선</div></div><div><canvas class="gcv" id="cv4b"></canvas><div class="cap">해당 계절의 밤하늘 은하수</div></div></div>
    <div class="gctl"><span>월(Month) 선택</span><input type="range" id="mon" min="1" max="12" value="${gMonth}" aria-label="월"><span class="val" id="monV"></span></div>`;
  const cv = $('#cv4'), cv2 = $('#cv4b');

  const draw = () => {
    const { c, w, h } = sizeCanvas(cv, 0.62);
    c.fillStyle = '#03040a'; c.fillRect(0, 0, w, h);
    const cx = w / 2, cy = h / 2, R = Math.min(w * 0.25, h * 0.34);
    label(c, w - 8, 20, 'A: 은하 중심 방향 →', '#ffe2b0', 'right');
    label(c, w - 8, 40, '(궁수자리)', '#ffe2b0', 'right');
    label(c, 8, h - 38, '← B: 은하 외곽 방향', '#9fc2ff', 'left');
    label(c, 8, h - 18, '(오리온자리)', '#9fc2ff', 'left');

    c.strokeStyle = 'rgba(235,233,247,.35)'; c.setLineDash([3,4]); c.beginPath(); c.arc(cx, cy, R, 0, 7); c.stroke(); c.setLineDash([]);
    const sg = c.createRadialGradient(cx, cy, 0, cx, cy, 22);
    sg.addColorStop(0, '#fff3c4'); sg.addColorStop(1, 'rgba(255,200,80,0)');
    c.fillStyle = sg; c.beginPath(); c.arc(cx, cy, 22, 0, 7); c.fill();
    label(c, cx, cy + 28, '태양', '#f2c14e');

    const th = (gMonth - 7) * Math.PI / 6;
    const ex = cx + Math.cos(th)*R, ey = cy - Math.sin(th)*R;
    c.fillStyle = '#5aa9ff'; c.beginPath(); c.arc(ex, ey, 12, 0, 7); c.fill();
    c.fillStyle = '#0b1530'; c.beginPath(); c.arc(ex, ey, 12, -th - Math.PI/2, -th + Math.PI/2); c.closePath(); c.fill();
    c.strokeStyle = '#5aa9ff'; c.lineWidth = 1; c.beginPath(); c.arc(ex, ey, 12, 0, 7); c.stroke();

    c.strokeStyle = '#f2c14e'; c.lineWidth = 2.5;
    const ax = ex + Math.cos(th)*R*0.75, ay = ey - Math.sin(th)*R*0.75;
    c.beginPath(); c.moveTo(ex + Math.cos(th)*12, ey - Math.sin(th)*12); c.lineTo(ax, ay); c.stroke();
    label(c, ex, ey + (Math.sin(th) > 0 ? -24 : 26), `지구 (${gMonth}월)`);

    const f = Math.cos(th), k = (f + 1) / 2;
    $('#monV').textContent = `${gMonth}월 · ${k > 0.75 ? 'A 방향(은하 중심) 관측' : k < 0.25 ? 'B 방향(은하 외곽) 관측' : '경계 영역 관측'}`;

    const S2 = sizeCanvas(cv2, 0.62), c2 = S2.c;
    c2.fillStyle = '#03040a'; c2.fillRect(0, 0, S2.w, S2.h);
    const rr = rng('band');
    for (let i = 0; i < 160; i++) dot(c2, rr()*S2.w, rr()*S2.h, rr()*0.9 + 0.3, '#dfe6ff', 0.5);
    c2.save(); c2.translate(S2.w / 2, S2.h / 2); c2.rotate(-0.5);
    c2.globalCompositeOperation = 'lighter';
    const thick = S2.h * (0.07 + k * 0.2), bright = 0.25 + k * 0.75;
    for (let i = 0; i < Math.round(500 + k * 2200); i++) {
      const x = (rr() - .5) * S2.w * 1.5, y = ((rr() + rr() + rr() - 1.5) / 1.5) * thick;
      dot(c2, x, y, rr()*1 + 0.3, k > 0.6 && rr() < .35 ? '#ffe2b0' : '#e8ecff', bright * (0.3 + rr()*0.5));
    }
    const gr = c2.createLinearGradient(0, -thick, 0, thick);
    gr.addColorStop(0, 'rgba(200,190,255,0)');
    gr.addColorStop(.5, `rgba(${k > 0.6 ? '255,215,170' : '200,205,255'},${0.08 + k * 0.22})`);
    gr.addColorStop(1, 'rgba(200,190,255,0)');
    c2.fillStyle = gr; c2.fillRect(-S2.w, -thick, S2.w * 2, thick * 2);
    c2.restore(); c2.globalCompositeOperation = 'source-over';
    label(c2, S2.w / 2, S2.h - 16, k > 0.75 ? '두껍고 뚜렷한 은하수' : k < 0.25 ? '가늘고 희미한 은하수' : '중간 밝기 은하수', k > 0.6 ? '#ffe2b0' : '#c9d2ff');
  };
  draw();
  $('#mon').oninput = e => { gMonth = +e.target.value; draw(); };
}

/* 컨트롤 & 탭 전환 */
$('#clsSel').innerHTML = CLASSES.map(c => `<option value="${esc(c)}">${esc(c)}반</option>`).join('');
$('#numSel').innerHTML = '<option value="">선택</option>' + Array.from({length:NSTU}, (_,i) => `<option value="${i+1}">${i+1}번</option>`).join('');

if (!CLASSES.includes(S.cls)) S.cls = CLASSES[0];
$('#clsSel').value = S.cls; $('#numSel').value = S.num;

function changeTeam(){
  const c = $('#clsSel').value, u = $('#numSel').value;
  if (c === S.cls && u === S.num) return;
  const fresh = S.num !== '';
  S.cls = c; S.num = u;
  if (fresh) { S.found = {}; S.quiz = {}; S.galaxy = {}; }
  teamRows = []; save(); renderAll(); loadTeam();
}
$('#clsSel').onchange = changeTeam;
$('#numSel').onchange = changeTeam;

document.querySelectorAll('.tab').forEach(t => t.onclick = () => {
  document.querySelectorAll('.tab').forEach(x => x.setAttribute('aria-selected', x === t));
  ['galaxy','mission','dex','note','quiz'].forEach(k => $('#tab-' + k).hidden = k !== t.dataset.tab);
  if (t.dataset.tab === 'galaxy') renderGalaxy();
  if (t.dataset.tab === 'note') renderNote();
  if (t.dataset.tab === 'dex') { renderDex(); showTeamStat(); loadTeam(); }
});

$('#resetBtn').onclick = () => { $('#resetConfirm').hidden = false; };
$('#resetNo').onclick = () => { $('#resetConfirm').hidden = true; };
$('#resetYes').onclick = () => { S.found = {}; S.quiz = {}; S.galaxy = {}; save(); $('#resetConfirm').hidden = true; renderAll(); };

/* 선생님 모드 및 현황판 */
let PIN = '', dashRows = [], dashTimer = null, dashErr = '', dashUserPicked = false;
$('#teacherBtn').onclick = async () => {
  if (TEACH) { if (await loadDash()) openDash(); return; }
  if (!GAS) {
    $('#sheet').innerHTML = `<div class="sheet-head"><h2>선생님 모드 안내</h2><button class="x" aria-label="닫기">✕</button></div>
      <p>현재 Google Apps Script URL이 설정되지 않아 브라우저 내부 모드로 작동 중입니다.</p>`;
    bindClose(); openSheet(); return;
  }
  $('#sheet').innerHTML = `<div class="sheet-head"><h2>선생님 인증</h2><button class="x" aria-label="닫기">✕</button></div>
    <form class="pinbox" id="pinForm"><label for="pinIn">PIN 번호 입력</label><input id="pinIn" type="password" inputmode="numeric" autocomplete="off">
    <div id="pinErr" style="color:var(--emis)"></div><button class="cta" style="margin-top:0">탐사 현황 열기</button></form>`;
  bindClose(); openSheet(); $('#pinIn').focus();
  $('#pinForm').onsubmit = async e => {
    e.preventDefault();
    PIN = $('#pinIn').value.trim();
    $('#pinErr').textContent = '인증 확인 중...';
    const ok = await loadDash();
    if (ok) { closeSheet(); enterTeacher(); openDash(); }
    else { $('#pinErr').textContent = dashErr; }
  };
};

async function loadDash(){
  const all = $('#dAll').getAttribute('aria-pressed') === 'true';
  const day = all ? '' : ($('#dDay').value || today());
  try {
    const r = await fetch(`${GAS}?pin=${encodeURIComponent(PIN)}${day ? `&day=${day}` : ''}&t=${Date.now()}`, {cache:'no-store'});
    const j = await r.json();
    if (!j.ok) {
      dashErr = j.error === 'pin' ? 'PIN 번호가 올바르지 않습니다.' : '로드 실패: ' + j.error;
      return false;
    }
    dashRows = j.rows || [];
    $('#dStatus').className = 'sync ok';
    $('#dStatus').textContent = new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'}) + ' 갱신';
    return true;
  } catch(e) {
    dashErr = '서버 연결에 실패했습니다.';
    $('#dStatus').className = 'sync wait';
    return false;
  }
}

function normCls(c){
  c = String(c == null ? '' : c).trim();
  const m = c.match(/^(\d{4})-(\d{2})-(\d{2})T/);
  if (m) { const d = new Date(c); return `${d.getMonth()+1}-${d.getDate()}`; }
  return c;
}

function openDash(){
  $('#dash').hidden = false;
  if (!$('#dDay').value) $('#dDay').value = today();
  dashRows.forEach(r => {
    r.cls = normCls(r.cls);
    r.num = String(r.num == null ? '' : r.num).trim();
    r.team = String(r.team == null ? '' : r.team).trim();
  });
  const cl = [...new Set([...CLASSES, ...dashRows.map(r => r.cls).filter(Boolean)])];
  const cnt = {};
  dashRows.forEach(r => cnt[r.cls] = (cnt[r.cls] || 0) + 1);
  let keep = $('#dCls').value;
  if (!dashUserPicked) {
    const last = dashRows.slice().sort((a,b) => b.ts - a.ts)[0];
    keep = last ? last.cls : (keep || S.cls);
  }
  $('#dCls').innerHTML = cl.map(c => `<option value="${esc(c)}">${esc(c)}반${cnt[c] ? ` (${cnt[c]})` : ''}</option>`).join('');
  $('#dCls').value = cl.includes(keep) ? keep : cl[0];
  renderDash();
  clearInterval(dashTimer);
  dashTimer = setInterval(async () => {
    if (!$('#dash').hidden && await loadDash()) openDash();
  }, 10000);
}

function renderDash(){
  const cls = $('#dCls').value;
  const seen = new Set(), latest = {};
  dashRows.filter(r => String(r.cls) === cls).sort((a,b) => a.ts - b.ts).forEach(r => {
    if (seen.has(r.uid)) return;
    seen.add(r.uid);
    latest[r.num + '|' + r.id] = r;
  });
  const stu = {};
  Object.values(latest).forEach(r => { stu[r.num] = String(r.team); });
  const nums = Object.keys(stu).sort((a,b) => (+stu[a] - +stu[b]) || (+a - +b));
  const short = { mw:'은하수', beehive:'벌집', pleiades:'좀생이', jewelbox:'보석상자', tuc47:'47 Tuc', omega:'오메가', m13:'M13', crescent:'초승달', chicken:'닭성운', rosette:'장미', runningman:'런닝맨', iris:'아이리스', coalsack:'석탄포대', horsehead:'말머리' };
  const zh = t => ({ open:'1구역', globular:'2구역', emission:'3구역', reflection:'4구역', dark:'5구역', milkyway:'보너스' }[t]);

  let h = `<table><thead><tr><th>모둠 · 번호</th>${OBJ.map(o => `<th>${zh(o.type)}<br>${short[o.id]}</th>`).join('')}<th>우리은하</th><th>구역</th><th>점수</th><th>퀴즈</th><th>최근 활동</th></tr></thead><tbody>`;
  let prevTeam = null;
  nums.forEach(u => {
    let p = 0, last = 0;
    const zones = new Set();
    const cells = OBJ.map(o => {
      const r = latest[u + '|' + o.id];
      if (!r) return '<td></td>';
      p += +r.points || 0;
      last = Math.max(last, r.ts);
      if (o.type !== 'milkyway') zones.add(o.type);
      const secs = +r.secs || 0, fast = secs < 30, shortM = String(r.memo || '').trim().length < 10;
      return `<td><button class="cell${fast ? ' fast' : ''}${shortM ? ' short' : ''}" data-k="${u}|${o.id}"><span class="s">${'★'.repeat(+r.points||0) || '·'}</span><span class="t num">${fmtSecs(secs)}</span></button></td>`;
    }).join('');

    const q = latest[u + '|quiz'];
    if (q) last = Math.max(last, q.ts);
    let gn = 0, gp = 0;
    ['g1','g2','g3','g4'].forEach(g => {
      const r = latest[u + '|' + g];
      if (r) { gn++; gp += +r.points || 0; last = Math.max(last, r.ts); }
    });
    const sep = prevTeam !== null && prevTeam !== stu[u] ? ' style="border-top:3px solid var(--line)"' : '';
    prevTeam = stu[u];
    h += `<tr${sep}><td>${esc(stu[u])}모둠 ${u ? esc(u) + '번' : '(무기명)'}</td>${cells}<td class="num" style="color:${gn>=4?'var(--ok)':'inherit'}">${gn ? `${gn}/4 ★${gp}` : ''}</td><td class="num" style="color:${zones.size>=5?'var(--ok)':'inherit'}">${zones.size}/5</td><td class="num">${p}</td><td class="num">${q ? q.points + '/' + QUIZ.length : ''}</td><td class="num">${last ? new Date(last).toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'}) : ''}</td></tr>`;
  });

  if (!nums.length) h += `<tr><td colspan="${OBJ.length+6}" style="text-align:left;color:var(--muted);font-size:14px">기록된 데이터가 없습니다.</td></tr>`;
  const absent = Array.from({length:NSTU}, (_,i) => String(i+1)).filter(x => !stu[x]);
  $('#dMatrix').innerHTML = h + '</tbody></table>';
  $('#dAbsent').innerHTML = absent.length ? `미참여 학생 번호: <b>${absent.join(', ')}</b>` : '모든 학생이 참여 중입니다.';

  $('#dMatrix').querySelectorAll('.cell').forEach(b => b.onclick = () => {
    const r = latest[b.dataset.k], o = OBJ.find(x => x.id === r.id);
    const G = TYPES[r.guess];
    $('#dDetail').innerHTML = `<h3>${esc(cls)}반 ${esc(String(r.team))}모둠 ${esc(String(r.num))}번 · ${o.name}</h3>
      <div class="row"><span>제출: ${new Date(r.ts).toLocaleTimeString('ko-KR')}</span><span>소요: ${fmtSecs(+r.secs||0)}</span><span>점수: ${'★'.repeat(+r.points||0)||'0'}</span>${o.type!=='milkyway'?`<span>판단: ${G?G.name:'-'} (정답: ${TYPES[o.type].name})</span>`:''}</div>
      <blockquote>${esc(String(r.memo || '(작성 메모 없음)'))}</blockquote>`;
  });
}

function fmtSecs(s){ return s >= 60 ? `${Math.floor(s/60)}분 ${s%60}초` : `${s}초`; }
$('#dCls').onchange = () => { dashUserPicked = true; renderDash(); };
$('#dAll').onclick = async () => {
  const on = $('#dAll').getAttribute('aria-pressed') !== 'true';
  $('#dAll').setAttribute('aria-pressed', on);
  $('#dDay').disabled = on;
  if (await loadDash()) openDash();
};
$('#dDay').onchange = async () => { if (await loadDash()) openDash(); };
$('#dRefresh').onclick = async () => { if (await loadDash()) openDash(); };
$('#dClose').onclick = () => { $('#dash').hidden = true; clearInterval(dashTimer); };

function setTbh(){
  const b = $('#teachbar');
  document.documentElement.style.setProperty('--tbh', (b.hidden ? 0 : b.offsetHeight) + 'px');
}
window.addEventListener('resize', setTbh);

function syncSelects(){
  $('#clsSel').value = S.cls; $('#numSel').value = S.num;
}
function enterTeacher(){
  if (TEACH) return;
  TEACH = true; SAVED = S;
  S = { cls:SAVED.cls, teamNo:SAVED.teamNo, num:'', found:{}, quiz:{}, galaxy:{}, queue:[] };
  teamRows = []; gAns = {}; gTap = null;
  syncSelects();
  $('#teachbar').hidden = false; setTbh();
  $('#teacherBtn').textContent = '탐사 현황'; $('#resetBtn').textContent = '시범 기록 초기화';
  renderAll(); flush();
}
function exitTeacher(){
  if (!TEACH) return;
  TEACH = false; S = SAVED; SAVED = null;
  teamRows = []; gAns = {}; gTap = null;
  syncSelects();
  $('#teachbar').hidden = true; setTbh(); $('#dash').hidden = true; clearInterval(dashTimer); PIN = '';
  $('#teacherBtn').textContent = '선생님'; $('#resetBtn').textContent = '처음부터 다시';
  renderAll(); loadTeam(); flush();
}
$('#tbDash').onclick = async () => { if (await loadDash()) openDash(); };
$('#tbExit').onclick = exitTeacher;

flush();
loadTeam();
$('#teamReload').onclick = () => { teamStat = { state:'idle', msg:'' }; showTeamStat(); loadTeam(); };
document.addEventListener('visibilitychange', () => { if (!document.hidden) loadTeam(); });

function renderAll(){
  renderTop();
  if (!$('#tab-galaxy').hidden) renderGalaxy();
  else gDotsOnly();
  renderMissions();
  if (!$('#tab-dex').hidden) renderDex();
  renderNote();
  renderQuiz();
}

let rt;
window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(renderAll, 250); });
if (document.fonts && document.fonts.ready) document.fonts.ready.then(renderAll);
renderAll();
window.__appReady = true;
</script>
