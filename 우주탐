<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>우리은하 천체 탐험대</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Do+Hyeon&family=Gowun+Dodum&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: 관측소 카탈로그 카드 격자 + 하단 모달 시트. 우주 테마 다크 모드 기본 */
:root{
  --sky:#0a0c18; --panel:#12162b; --panel2:#191e38; --line:#2a3058;
  --fg:#ebe9f7; --muted:#9a9dc2; --gold:#f2c14e; --gold-ink:#1a1405;
  --open:#7fb1ff; --glob:#ffb46e; --emis:#ff6f86; --refl:#7fd0ff; --dark:#a49cb8; --mw:#d9c7ff;
  --ok:#6fdc9a; --warn:#ffb46e;
  --display:"Do Hyeon","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --body:"Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--sky);color:var(--fg);font-family:var(--body);font-size:16px;line-height:1.6}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--sky)}
.wrap{max-width:1080px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 48px}
h1,h2,h3,h4{font-family:var(--display);font-weight:400;text-wrap:balance;margin:0;letter-spacing:.01em}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
[hidden]{display:none!important}

/* Header */
.top{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end;justify-content:space-between}
.title h1{font-size:clamp(30px,6vw,44px);line-height:1.1}
.title p{margin:6px 0 0;color:var(--muted);max-width:60ch}
.team{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.team label{font-size:13px;color:var(--muted);letter-spacing:.06em}
.team select{background:var(--panel);border:1px solid var(--line);border-radius:8px;color:var(--fg);font:inherit;padding:8px 10px}
.score{font-family:var(--display);font-size:22px;background:var(--gold);color:var(--gold-ink);border-radius:999px;padding:4px 16px;font-variant-numeric:tabular-nums;white-space:nowrap}
.sync{font-size:13px;border-radius:999px;padding:3px 10px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.sync.ok{color:var(--ok);border-color:var(--ok)}
.sync.wait{color:var(--warn);border-color:var(--warn)}

/* Tabs */
.tabs{position:sticky;top:calc(env(safe-area-inset-top,0px) + var(--tbh,0px));z-index:20;background:var(--sky);display:flex;gap:6px;margin:22px 0 18px;padding:8px 0;border-bottom:1px solid var(--line);overflow-x:auto}
.tab{background:none;border:0;padding:8px 14px;border-radius:8px;font-family:var(--display);font-size:19px;color:var(--muted);white-space:nowrap}
.tab[aria-selected="true"]{background:var(--panel2);color:var(--fg)}
.tab .n{font-family:var(--mono);font-size:12px;margin-left:6px;color:var(--gold)}
@media (max-width:520px){.tabs{gap:2px}.tab{font-size:16px;padding:6px 8px}.tab .n{font-size:11px;margin-left:3px}}

/* Tip Strip */
.tip{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin-bottom:18px;font-size:15px}
.tip a{color:var(--gold);font-weight:700}
.tip span{color:var(--muted)}

/* Mission Grid */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.card{position:relative;text-align:left;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:0;overflow:hidden;display:flex;flex-direction:column;transition:transform .15s,border-color .15s}
.card:hover{transform:translateY(-2px);border-color:var(--muted)}
.card .thumb{display:block;width:100%;aspect-ratio:16/9;background:#05060d;max-width:100%}
.card .body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:4px;min-width:0}
.card .code{font-family:var(--mono);font-size:12px;color:var(--muted);letter-spacing:.04em}
.card .m{font-family:var(--display);font-size:20px;line-height:1.25}
.card .meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.chip{font-size:12px;border:1px solid var(--line);border-radius:999px;padding:1px 9px;color:var(--muted)}
.chip.south{border-color:var(--warn);color:var(--warn)}
.chip.type{color:var(--sky);border:0;font-weight:700}
.stamp{position:absolute;top:10px;right:10px;font-family:var(--display);background:var(--gold);color:var(--gold-ink);border-radius:999px;padding:2px 12px;font-size:15px;box-shadow:0 2px 10px #0008}

/* Sheet & Modal */
.overlay{position:fixed;inset:0;z-index:40;background:#03040acc;display:flex;align-items:flex-end;justify-content:center;padding-top:calc(24px + env(safe-area-inset-top,0px))}
.sheet{background:var(--panel);border:1px solid var(--line);border-bottom:0;border-radius:18px 18px 0 0;width:100%;max-width:640px;max-height:100%;overflow-y:auto;padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px));padding-block:18px calc(22px + env(safe-area-inset-bottom,0px))}
@media (min-width:700px){.overlay{align-items:center;padding:24px}.sheet{border-radius:18px;border-bottom:1px solid var(--line)}}
.sheet-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.x{background:var(--panel2);border:0;border-radius:999px;width:36px;height:36px;flex:none;font-size:18px}
.sheet h2{font-size:26px;line-height:1.2}
.sheet .code{font-family:var(--mono);color:var(--gold);font-size:14px}
.howto{background:var(--panel2);border-radius:12px;padding:12px 14px;display:grid;gap:6px;font-size:15px;margin:12px 0}
.howto b{color:var(--gold);font-weight:700}
.howto .alert{color:var(--warn)}
.memo{margin-top:16px}
.memo h3{font-size:20px;margin-bottom:4px}
.memo p{margin:0 0 8px;color:var(--muted);font-size:14px}
.memo textarea{width:100%;min-height:80px;background:var(--panel2);border:1px solid var(--line);border-radius:12px;color:var(--fg);font:inherit;padding:10px 12px;resize:vertical}
.memo .cnt{font-size:13px;color:var(--muted);text-align:right}
.q{margin:18px 0 0}
.q h3{font-size:20px;margin-bottom:10px}
.opts{display:grid;gap:8px}
.opt{text-align:left;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:16px}
.opt:hover{border-color:var(--muted)}
.opt[aria-pressed="true"]{border-color:var(--gold);background:#2a2412}
.cta{display:block;width:100%;margin-top:18px;background:var(--gold);color:var(--gold-ink);border:0;border-radius:12px;padding:14px;font-family:var(--display);font-size:21px;text-align:center}
.cta[disabled]{opacity:.35;cursor:default}
.ghost{background:none;border:1px solid var(--line);border-radius:12px;padding:10px 14px;color:var(--muted)}
.reveal canvas{width:100%;aspect-ratio:16/9;border-radius:12px;display:block;background:#05060d}
.verdict{margin-top:14px;padding:14px;border-radius:12px;background:var(--panel2)}
.verdict .big{font-family:var(--display);font-size:24px}
.verdict.good .big{color:var(--ok)}
.verdict.miss .big{color:var(--warn)}
.typebox{margin-top:12px;display:grid;gap:4px}
.typebox .name{font-family:var(--display);font-size:22px}
.fact{margin-top:12px;font-size:15px;color:var(--muted);border-top:1px dashed var(--line);padding-top:10px}
.nick{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.nick input{flex:1;min-width:0;background:var(--panel2);border:1px solid var(--line);border-radius:10px;color:var(--fg);font:inherit;padding:10px 12px}
.stars{color:var(--gold);letter-spacing:2px;font-size:20px}
.mymemo{margin-top:12px;background:var(--panel2);border-radius:12px;padding:10px 14px;font-size:15px}
.mymemo b{color:var(--gold);font-weight:400;font-family:var(--display)}

/* Dex */
.shelf{margin-bottom:22px}
.shelf-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;margin-bottom:10px}
.shelf-head h2{font-size:24px}
.shelf-head .sub{color:var(--muted);font-size:14px}
.dot{width:12px;height:12px;border-radius:50%;display:inline-block;align-self:center}
.dex{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.dex-item{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;text-align:left;padding:0}
.dex-item canvas{display:block;width:100%;aspect-ratio:4/3}
.dex-item .lbl{padding:8px 10px;font-size:14px}
.dex-item .lbl small{display:block;color:var(--gold);font-size:12px}
.dex-item .by{display:block;color:var(--muted);font-size:12px}
.dex-item.empty{display:grid;place-items:center;aspect-ratio:4/3.9;color:var(--muted);font-family:var(--display);font-size:30px;border-style:dashed}
.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:8px}
.note{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;min-width:0}
.note h3{font-size:22px;margin-bottom:4px}
.note p{margin:0 0 10px;color:var(--muted);font-size:15px}
.tblwrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:14px;min-width:280px}
th,td{border-top:1px solid var(--line);padding:7px 6px;text-align:left;vertical-align:top}
th{color:var(--muted);font-weight:400;white-space:nowrap}
.mantra{margin-top:14px;display:grid;gap:6px;font-size:15px}
.mantra div{background:var(--panel2);border-radius:10px;padding:8px 12px}
.lockmsg{color:var(--muted);font-size:14px;margin:0 0 12px}

/* Quiz */
.qcard{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:12px}
.qcard h3{font-size:20px;margin-bottom:10px}
.qcard .num{font-family:var(--mono);color:var(--gold);font-size:13px;display:block;margin-bottom:2px}
.opt.right{border-color:var(--ok);background:#12301f}
.opt.wrong{border-color:var(--emis);background:#3a1620}
.expl{margin-top:10px;font-size:15px;color:var(--muted)}
.rowbtns{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}

/* Galaxy tab */
.gintro{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:18px;display:grid;gap:8px}
.gintro h2{font-size:24px}
.gintro p{margin:0;color:var(--muted);font-size:15px}
.gstep{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:18px;display:grid;gap:12px;min-width:0}
.gstep.done{border-color:#3b6b52}
.ghead{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:baseline}
.ghead .no{font-family:var(--mono);color:var(--gold);font-size:13px}
.ghead h3{font-size:23px}
.ghead .ok{color:var(--ok);font-size:14px}
.gstep .lead{margin:0;font-size:15px}
.gstep .lead b{color:var(--gold);font-weight:400;font-family:var(--display);font-size:17px}
.gcv{display:block;width:100%;max-width:100%;border-radius:12px;background:#03040a;touch-action:manipulation}
.gpair{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.gpair .cap{font-size:13px;color:var(--muted);margin-top:4px}
.gctl{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;font-size:14px;color:var(--muted)}
.gctl input[type=range]{flex:1;min-width:160px;accent-color:var(--gold)}
.gctl .val{font-family:var(--display);font-size:18px;color:var(--fg);min-width:5.5em}
.tog{background:var(--panel2);border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:14px;color:var(--muted)}
.tog[aria-pressed="true"]{border-color:var(--gold);color:var(--gold)}
.gmsg{background:var(--panel2);border-radius:10px;padding:10px 12px;font-size:15px}
.gmsg.good{color:var(--ok)}
.gmsg.miss{color:#ffd29a}
.meter{height:12px;border-radius:999px;background:var(--panel2);overflow:hidden;border:1px solid var(--line)}
.meter i{display:block;height:100%;background:linear-gradient(90deg,#7fb1ff,#f2c14e);width:0;transition:width .2s}
.gq{display:grid;gap:8px}
.gq h4{margin:6px 0 0;font-family:var(--display);font-weight:400;font-size:18px}
.gq .opt.right{border-color:var(--ok);background:#12301f}
.gq .opt.wrong{border-color:var(--emis);background:#3a1620}
.gq .why{font-size:14px;color:var(--muted)}
.gbtns{display:flex;flex-wrap:wrap;gap:10px}
.gbtns .cta{width:auto;margin-top:0;padding:10px 22px;font-size:19px}

/* Zones & Team */
.tstat{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:16px;font-size:14px;color:var(--muted)}
.tstat.ok span{color:var(--ok)}
.tstat.err{border-color:var(--emis)}
.tstat.err span{color:#ffb3c0}
.tstat .ghost{padding:6px 12px}
.goal{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:18px;display:grid;gap:10px}
.goal h2{font-size:22px}
.goal p{margin:0;color:var(--muted);font-size:14px}
.zdots{display:flex;flex-wrap:wrap;gap:8px}
.zdot{font-family:var(--display);font-size:16px;border:1px dashed var(--line);border-radius:999px;padding:3px 14px;color:var(--muted)}
.zdot.done{border:1px solid var(--gold);background:var(--gold);color:var(--gold-ink)}
.zone{margin-bottom:22px}
.zone-head{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:baseline;margin-bottom:10px}
.zone-head h2{font-size:24px}
.zone-head .sub{color:var(--muted);font-size:14px}
.zone-head .ok{color:var(--ok);font-size:14px}
.mates{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.mate{font-size:12px;border-radius:999px;padding:1px 8px;background:#2a2412;color:var(--gold);border:1px solid #5a4a1a}
.mate.me{background:var(--gold);color:var(--gold-ink);border-color:var(--gold)}
.teamfeed{display:grid;gap:8px;margin-top:6px}
.feed{background:var(--panel2);border-radius:10px;padding:8px 12px;font-size:14px}
.feed b{color:var(--gold);font-weight:400;font-family:var(--display)}

/* Presentation View */
.present{position:fixed;inset:0;z-index:50;background:radial-gradient(ellipse at 50% 30%,#1d2350,var(--sky) 70%);display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:18px;text-align:center;padding:calc(24px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(24px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));overflow-y:auto}
.pslide{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;width:100%;max-width:820px}
.tname{font-family:var(--display);font-size:clamp(36px,8vw,72px);line-height:1}
.bigscore{font-family:var(--display);font-size:clamp(26px,5vw,46px);color:var(--gold)}
.fav{max-width:520px;width:100%}
.fav canvas{width:100%;aspect-ratio:16/9;border-radius:14px;display:block}
.favname{font-family:var(--display);font-size:clamp(22px,4vw,36px);margin-top:10px}
.favreal{color:var(--muted)}
.badges{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.pnav{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:center}
.pnav .tool[disabled]{opacity:.35}
.pcount{font-family:var(--mono);color:var(--muted);min-width:5em}
.pkind{font-family:var(--display);font-size:clamp(20px,3.5vw,28px)}
.pmemos{display:grid;gap:8px;width:100%;max-width:640px;text-align:left}
.pmemo{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:clamp(15px,2.2vw,19px)}
.pmemo b{font-family:var(--display);font-weight:400;color:var(--gold);margin-right:6px}
.pfact{color:var(--muted);font-size:15px;max-width:640px}
.pnote{color:var(--muted);font-size:16px}
.psum{display:grid;gap:10px;width:100%;max-width:720px;text-align:left}
.psrow{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:clamp(15px,2.2vw,19px)}
.pmiss{margin-left:auto;font-size:13px;color:var(--warn)}

/* Toolbar & Teacher Mode */
.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px}
.tool{background:var(--panel2);border:1px solid var(--line);border-radius:999px;padding:7px 16px;font-family:var(--display);font-size:16px;color:var(--fg)}
.tool:hover{border-color:var(--gold)}
#teacherBtn{margin-left:auto}
#resetConfirm{font-size:14px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.teachbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:25;background:#3a2c08;border-bottom:1px solid var(--gold)}
.teachbar .in{max-width:1080px;margin:0 auto;display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;padding:8px max(16px,env(safe-area-inset-right,0px)) 8px max(16px,env(safe-area-inset-left,0px));font-size:14px;color:#ffe9b0}
.teachbar b{font-family:var(--display);font-weight:400;font-size:18px;color:var(--gold)}
.teachbar .tool{padding:5px 12px;font-size:15px}

/* Teacher Dashboard */
.pinbox{display:grid;gap:10px;margin-top:14px}
.pinbox input{background:var(--panel2);border:1px solid var(--line);border-radius:10px;color:var(--fg);font:inherit;font-size:22px;padding:10px 12px;letter-spacing:.3em}
.dash{position:fixed;inset:0;z-index:45;background:var(--sky);overflow-y:auto}
.dash .wrap{max-width:none}
.dash-top{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:14px}
.dash-top h2{font-size:28px}
.dash-ctrl{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.dash-ctrl select,.dash-ctrl input{background:var(--panel);border:1px solid var(--line);border-radius:8px;color:var(--fg);font:inherit;padding:6px 10px}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:13px;color:var(--muted);margin-bottom:10px}
.matrix{overflow-x:auto;border:1px solid var(--line);border-radius:12px}
.matrix table{min-width:900px;font-size:13px}
.matrix th,.matrix td{text-align:center;padding:6px 5px;border-top:1px solid var(--line);border-left:1px solid var(--line)}
.matrix th:first-child,.matrix td:first-child{position:sticky;left:0;background:var(--panel);text-align:left;white-space:nowrap;font-family:var(--display);font-size:16px;border-left:0}
.matrix thead th{color:var(--muted);font-weight:400;vertical-align:bottom;border-top:0;font-size:12px;line-height:1.3}
.cell{background:none;border:0;padding:2px 4px;border-radius:6px;font-variant-numeric:tabular-nums;width:100%}
.cell .s{color:var(--gold);display:block;letter-spacing:1px}
.cell .t{font-size:11px;color:var(--muted)}
.cell.fast{background:#4a1b22}
.cell.fast .t{color:#ffb3c0}
.cell.short{outline:1px dashed var(--warn)}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
.detail{margin-top:14px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;min-height:60px}
.detail h3{font-size:20px;margin-bottom:6px}
.detail .row{display:flex;flex-wrap:wrap;gap:6px 16px;color:var(--muted);font-size:14px;margin-bottom:6px}
.detail blockquote{margin:8px 0 0;padding:10px 12px;background:var(--panel2);border-radius:10px;font-size:16px}
.absent{margin-top:12px;color:var(--muted);font-size:14px}
.absent b{color:var(--warn);font-weight:400}
.banner{background:#4a1b22;color:#ffd7dd;padding:10px 16px;font-size:14px}

@media (max-width:560px){
  .grid{grid-template-columns:1fr 1fr;gap:10px}
  .card .m{font-size:16px}
  .card .code{font-size:11px}
  .card .body{padding:10px}
  .lg{display:none}
