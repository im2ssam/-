/* 탐사 시트 */
let cur = null, ans = {}, openedAt = 0, memo = '';
function questionsFor(o){
  if (o.type === 'milkyway') return [
    { k:'season', t:'은하수가 더 두껍고 밝게 보인 때는?', o:[['jul','7월 밤'],['jan','1월 밤']] },
    { k:'dir', t:'그때 바라본 쪽은 우리은하의 어느 방향일까?', o:[['A','A 쪽 (은하 중심 방향)'],['B','B 쪽 (은하 바깥 방향)']] },
    { k:'why', t:'왜 계절마다 다르게 보일까?', o:[['night','계절마다 밤하늘이 향하는 방향이 달라져서'],['near','여름에는 지구가 은하 중심에 가까이 가서'],['clear','여름 하늘이 더 맑아서']] }
  ];
  const qs = [{ k:'kind', t:'화면에서 무엇이 보였나요?', o:[['stars','작은 별들이 모여 있다'],['cloud','구름처럼 뿌옇게 퍼져 있다']] }];
  if (ans.kind === 'stars') {
    qs.push({ k:'shape', t:'별들은 어떻게 모여 있나요?', o:[['scatter','일정한 모양 없이 흩어져 있다'],['ball','공처럼 둥글고 빽빽하다']] });
    qs.push({ k:'color', t:'별들은 주로 무슨 색인가요?', o:[['blue','파란빛, 하얀빛'],['warm','노란빛, 붉은빛']] });
  }
  if (ans.kind === 'cloud') {
    qs.push({ k:'ccolor', t:'구름은 무슨 색으로 보이나요?', o:[['red','붉은색으로 빛난다'],['blue','파란색으로 빛난다'],['black','검은 그림자처럼 별빛을 가린다']] });
  }
  return qs;
}

function openMission(o){
  if (!S.num && !TEACH) {
    $('#sheet').innerHTML = `<div class="sheet-head"><h2>번호를 먼저 골라 주세요</h2><button class="x" aria-label="닫기">✕</button></div><p>화면 위쪽에서 반, 모둠, 번호를 고르면 탐사를 시작할 수 있어요.</p>`;
    bindClose(); openSheet(); return;
  }
  cur = o; ans = {};
  const f = S.found[o.id];
  if (f) { showReveal(f.answers, true); return; }
  showHow();
}

function showHow(){
  const o = cur;
  const how = o.how || [`검색창에 <b>${o.code}</b>를 입력해요.${o.alt ? ` 안 나오면 <b>${o.alt}</b>로 검색해요.` : ''}`, '찾은 천체를 크게 확대해서 자세히 관찰해요.'];
  if (o.south) how.splice(1, 0, '<span class="alert">우리나라에서는 지평선 아래에 있어요. 메뉴에서 지형을 끄세요.</span>');
  $('#sheet').innerHTML = `<div class="sheet-head"><div><div class="code">${o.code}${o.alt && !o.how ? ' · ' + o.alt : ''}</div><h2>${o.mission}</h2></div><button class="x" aria-label="닫기">✕</button></div>
    <div class="howto">${how.map(h => `<div>${h}</div>`).join('')}<div style="color:var(--muted)">별자리: ${o.con}</div></div>
    <div class="memo"><h3>관측 메모</h3><p>스텔라리움에서 직접 본 모습을 적어주세요. (별의 수, 모양, 색, 특징 등)</p>
    <textarea id="memoIn" maxlength="200" placeholder="10자 이상 작성해 주세요"></textarea><div class="cnt" id="memoCnt">0자</div></div>
    <div id="qs"></div><button class="cta" id="submit" disabled>관찰 결과 확인하기</button>`;
  openedAt = Date.now(); memo = '';
  $('#memoIn').addEventListener('input', e => {
    memo = e.target.value;
    $('#memoCnt').textContent = memo.trim().length + '자';
    updateSubmit();
  });
  bindClose(); renderQs(); openSheet();
}

function updateSubmit(){
  const qs = questionsFor(cur);
  const s = $('#submit');
  if (s) s.disabled = !(qs.every(q => ans[q.k]) && memo.trim().length >= 10);
}

function renderQs(){
  const qs = questionsFor(cur), box = $('#qs');
  box.innerHTML = '';
  qs.forEach(q => {
    const d = document.createElement('div');
    d.className = 'q';
    d.innerHTML = `<h3>${q.t}</h3><div class="opts">${q.o.map(([v,l]) => `<button class="opt" aria-pressed="${ans[q.k]===v}" data-k="${q.k}" data-v="${v}">${l}</button>`).join('')}</div>`;
    box.appendChild(d);
  });
  box.querySelectorAll('.opt').forEach(b => b.onclick = () => {
    const k = b.dataset.k; ans[k] = b.dataset.v;
    if (k === 'kind') { delete ans.shape; delete ans.color; delete ans.ccolor; }
    renderQs();
  });
  $('#submit').onclick = () => finish();
  updateSubmit();
}

function grade(o, a){
  if (o.type === 'milkyway') {
    let p = 0;
    if (a.season === 'jul') p++;
    if (a.dir === 'A') p++;
    if (a.why === 'night') p++;
    return { points:p, guess:'milkyway' };
  }
  const T = truth(o.type);
  let p = 0, guess;
  if (a.kind === 'stars') guess = a.shape === 'ball' ? 'globular' : 'open';
  else guess = { red:'emission', blue:'reflection', black:'dark' }[a.ccolor];

  if (a.kind === T.kind) {
    if (T.kind === 'stars') p = 1 + (a.shape === T.shape) + (a.color === T.color);
    else p = 1 + (a.ccolor === T.ccolor ? 2 : 0);
  }
  return { points:p, guess };
}

function finish(){
  const r = grade(cur, ans), secs = Math.round((Date.now() - openedAt) / 1000), m = memo.trim();
  S.found[cur.id] = { points:r.points, guess:r.guess, answers:{...ans}, nick:'', memo:m, secs };
  save();
  send({ kind:'mission', id:cur.id, points:r.points, guess:r.guess, memo:m, secs, extra:{ answers:{...ans} } });
  showReveal(ans, false);
  renderAll();
}

function showReveal(a, again){
  const o = cur, f = S.found[o.id], T = TYPES[o.type];
  let verdict;
  if (o.type === 'milkyway') {
    verdict = f.points === 3
      ? ['good', '은하수 박사!', '7월 밤에는 밤하늘이 우리은하 중심(A 쪽, 궁수자리)을 향해서 별이 많이 겹쳐 보여요.']
      : ['miss', '다시 확인해 볼까요?', '지구가 공전하며 밤하늘이 향하는 방향이 바뀝니다. 7월 밤에는 중심(A 쪽)을, 1월 밤에는 바깥(B 쪽)을 봐요.'];
  } else if (f.guess === o.type) {
    verdict = ['good', '관찰 성공!', `여러분이 관찰한 대로 ${T.name}입니다.`];
  } else if (f.restored && !f.guess) {
    verdict = ['miss', '저장된 기록', `이 천체는 ${T.name}이에요. ${hint(o.type)}`];
  } else {
    const G = TYPES[f.guess];
    verdict = ['miss', '다시 관찰해 볼까요?', `선택한 분류는 ${G ? G.name : '기타'}이지만 실제로는 ${T.name}에 해당해요. ${hint(o.type)}`];
  }

  $('#sheet').innerHTML = `<div class="sheet-head"><div><div class="code">${o.code}</div><h2>${o.name}</h2></div><button class="x" aria-label="닫기">✕</button></div>
    <div class="reveal" style="margin-top:12px"><canvas></canvas></div>
    <div class="verdict ${verdict[0]}"><div class="big">${verdict[1]} <span class="stars">${'★'.repeat(f.points)}${'☆'.repeat(3-f.points)}</span></div><div>${verdict[2]}</div></div>
    <div class="typebox"><span class="name" style="color:${T.color}">${o.type==='milkyway' ? '우리은하' : T.name}</span><span>${T.desc}</span><span style="color:var(--muted)">위치: ${T.where}</span></div>
    ${f.memo ? `<div class="mymemo"><b>내 관측 메모</b> ${esc(f.memo)}</div>` : ''}
    ${matesFor(o.id).length ? `<div class="teamfeed">${matesFor(o.id).map(m => `<div class="feed"><b>${esc(String(m.num))}번 관측</b> ${'★'.repeat(+m.points||0)} ${esc(String(m.memo||''))}</div>`).join('')}</div>` : ''}
    <div class="fact">알고 있었나요? ${o.fact}</div>
    <div class="nick"><input id="nickIn" maxlength="16" placeholder="우리 모둠이 지어 줄 별명" value="${(f.nick||'').replace(/"/g,'&quot;')}"><button class="ghost" id="nickSave">별명 저장</button></div>
    <div class="rowbtns" style="margin-top:12px"><button class="cta" id="done" style="margin-top:0">도감에 넣기</button>${again ? '<button class="ghost" id="redo">다시 관찰하기</button>' : ''}</div>`;
  
  bindClose(); openSheet();
  requestAnimationFrame(() => draw($('.reveal canvas'), o, false));
  $('#nickSave').onclick = () => { f.nick = $('#nickIn').value.trim(); save(); $('#nickSave').textContent = '저장됨'; renderAll(); };
