function renderGQs(st, el){
  const done = S.galaxy[st.id];
  const q = el.querySelector('.gq');
  const a = gAns[st.id] || (gAns[st.id] = {});
  const checked = !!(done && done.answers);

  q.innerHTML = st.qs.map((Q,k) => {
    const pick = checked ? done.answers[k] : a[k];
    return `<h4>Q${k+1}. ${Q.q}</h4><div class="opts">${Q.o.map((t,j) => {
      let cl = 'opt';
      if (checked) {
        if (j === Q.a) cl += ' right';
        else if (j === pick) cl += ' wrong';
      }
      return `<button class="${cl}" data-k="${k}" data-j="${j}" aria-pressed="${!checked && pick===j}" ${checked ? 'disabled' : ''}>${t}</button>`;
    }).join('')}</div>${checked ? `<div class="why">${pick===Q.a ? '정답!' : '해설'} ${Q.e}</div>` : ''}`;
  }).join('');

  q.querySelectorAll('.opt').forEach(b => b.onclick = () => {
    a[+b.dataset.k] = +b.dataset.j;
    renderGQs(st, el);
  });

  const btns = el.querySelector('.gbtns');
  if (done && done.restored && !done.answers) {
    btns.innerHTML = '<span class="why" style="color:var(--muted)">저장 기록 로드됨</span> <button class="ghost">다시 풀기</button>';
    btns.querySelector('button').onclick = () => { delete S.galaxy[st.id]; gAns[st.id] = {}; save(); renderGalaxy(); };
    return;
  }
  if (checked) {
    btns.innerHTML = '<button class="ghost">다시 풀기</button>';
    btns.querySelector('button').onclick = () => {
      delete S.galaxy[st.id]; gAns[st.id] = {};
      if (st.id === 'g1') gTap = null;
      save(); renderGalaxy();
      document.getElementById('step-' + st.id).scrollIntoView({ block:'start' });
    };
    return;
  }
  const need = st.qs.every((Q,k) => a[k] !== undefined) && (st.id !== 'g1' || gTap);
  btns.innerHTML = `<button class="cta"${need ? '' : ' disabled'}>확인하기</button>${!need && st.id==='g1' && !gTap ? '<span class="why" style="color:var(--muted)">지도에서 태양계 위치를 먼저 클릭해 주세요.</span>' : ''}`;
  btns.querySelector('.cta').onclick = () => {
    const ans = st.qs.map((Q,k) => a[k]);
    let pts = st.qs.filter((Q,k) => a[k] === Q.a).length;
    if (st.id === 'g1') pts = (gTap.ok ? 1 : 0) + pts;
    pts = Math.min(3, pts);
    S.galaxy[st.id] = { points:pts, answers:ans };
    save();
    send({ kind:'mission', id:st.id, points:pts, guess:'', memo:'', secs:Math.round((Date.now()-(gOpened[st.id]||Date.now()))/1000), extra:{ answers:ans, tap:st.id==='g1'?Math.round(gTap.pc):undefined } });
    renderGalaxy(); renderTop();
    document.getElementById('step-' + st.id).scrollIntoView({ block:'start' });
  };
}

