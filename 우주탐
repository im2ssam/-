    fact:'궁수자리 방향에 우리은하의 중심이 있어요. 그곳에는 태양 질량의 약 400만 배인 블랙홀이 숨어 있어요.' },
  { id:'beehive', type:'open', name:'벌집 성단', code:'NGC 2632', alt:'M44', con:'게자리', mission:'벌들이 모여 사는 집을 찾아라', fact:'맨눈으로는 희미한 얼룩처럼 보여서, 망원경이 나오기 전에는 구름으로 여겼대요.' },
  { id:'pleiades', type:'open', name:'좀생이성단', code:'M45', alt:'Pleiades', con:'황소자리', mission:'겨울밤의 일곱 자매를 찾아라', fact:'우리 조상들은 좀생이별이라 불렀어요. 일본 이름은 스바루이며 자동차 로고에 쓰여요.' },
  { id:'jewelbox', type:'open', name:'보석 상자', code:'NGC 4755', alt:'Jewel Box', con:'남십자자리', south:true, mission:'남쪽 하늘의 보석 상자를 열어라', fact:'파란 별들 사이에 붉은 별이 하나 박혀 있어서 보석함처럼 보여요.' },
  { id:'tuc47', type:'globular', name:'큰부리새자리 47', code:'NGC 104', alt:'47 Tuc', con:'큰부리새자리', south:true, mission:'큰부리새가 품은 별 공을 찾아라', fact:'수십만 개가 넘는 별이 지름 약 120광년 공간에 몰려 있어요.' },
