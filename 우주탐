function body3(b){
  gOpened.g3 = gOpened.g3 || Date.now();
  b.innerHTML = `<div class="gpair"><div><canvas class="gcv" id="cv3"></canvas><div class="cap">측면 시선 방향</div></div><div><canvas class="gcv" id="cv3b"></canvas><div class="cap">해당 시선의 가상 밤하늘</div></div></div>
    <div class="gctl"><span>시선 회전</span><input type="range" id="look" min="0" max="359" value="${gLook}" aria-label="바라보는 방향"><span class="val" id="lookV"></span></div>
    <div class="gctl" style="display:grid;gap:4px"><span>관측 별 밀도</span><div class="meter"><i id="lookM"></i></div></div>`;
  const cv = $('#cv3'), cv2 = $('#cv3b');
  const side = GAL.pts.map(q => ({ x:q.x, z:q.z }));
  const sun = GAL.sun;
  const count = a => {
    const cx = Math.cos(a), cz = -Math.sin(a);
    let n = 0;
    side.forEach(q => {
      const dx = q.x - sun.x, dz = q.z - sun.z;
      const d = Math.hypot(dx, dz);
      if (d < 0.02) return;
      if ((dx*cx + dz*cz)/d > Math.cos(0.09)) n++;
    });
    return n;
  };
  const maxN = count(0);

  const draw = () => {
    const G = drawGalaxy(cv, { tilt:90, ratio:0.62 });
    const c = cv.getContext('2d');
    const [sx,sy] = G.P(sun);
    const a = gLook * Math.PI / 180, L = G.sc * 2.2;
    c.fillStyle = 'rgba(242,193,78,.18)';
    c.beginPath();
    c.moveTo(sx, sy);
    c.lineTo(sx + Math.cos(a - 0.09)*L, sy - Math.sin(a - 0.09)*L);
    c.lineTo(sx + Math.cos(a + 0.09)*L, sy - Math.sin(a + 0.09)*L);
    c.closePath();
    c.fill();
    c.strokeStyle = '#f2c14e'; c.lineWidth = 2;
    c.beginPath(); c.moveTo(sx, sy); c.lineTo(sx + Math.cos(a)*G.sc*0.5, sy - Math.sin(a)*G.sc*0.5); c.stroke();
    sunMark(c, sx, sy);

    const n = count(a), f = Math.min(1, n / maxN);
    const dir = (gLook < 20 || gLook > 340) ? '은하 중심 방향' : (gLook > 160 && gLook < 200) ? '은하 외곽 방향' : '원반 수직/대각';
    $('#lookV').textContent = dir;
    $('#lookM').style.width = (4 + f * 96) + '%';

    const S2 = sizeCanvas(cv2, 0.62), c2 = S2.c;
    c2.fillStyle = '#03040a'; c2.fillRect(0, 0, S2.w, S2.h);
    const rr = rng('sky' + gLook);
    const N = Math.round(30 + f * 1400);
    c2.globalCompositeOperation = 'lighter';
    for (let i = 0; i < N; i++) {
      dot(c2, rr()*S2.w, rr()*S2.h, rr()*1.1 + 0.3, f > 0.5 && rr() < .3 ? '#ffe2b0' : '#dfe6ff', 0.35 + rr()*0.5);
    }
    if (f > 0.25) {
      const gr = c2.createLinearGradient(0, 0, S2.w, S2.h);
      gr.addColorStop(0, `rgba(255,220,170,${f * 0.12})`);
      gr.addColorStop(1, `rgba(160,180,255,${f * 0.08})`);
      c2.fillStyle = gr; c2.fillRect(0, 0, S2.w, S2.h);
    }
    c2.globalCompositeOperation = 'source-over';
  };
  draw();
  $('#look').oninput = e => { gLook = +e.target.value; draw(); };
}

