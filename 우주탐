  { id:'m13', type:'globular', name:'헤르쿨레스 구상 성단', code:'M13', alt:'NGC 6205', con:'헤르쿨레스자리', mission:'외계인에게 편지를 보낸 곳을 찾아라', fact:'1974년 외계 전파 메시지를 쏜 곳이에요. 도착하려면 약 2만 5천 년이 걸려요.' },
  { id:'crescent', type:'emission', name:'초승달 성운', code:'NGC 6888', alt:'Crescent Nebula', con:'백조자리', mission:'백조자리의 초승달을 찾아라', fact:'무겁고 뜨거운 별의 강한 바람이 가스를 밀어내 거품처럼 만든 성운이에요.' },
  { id:'chicken', type:'emission', name:'달리는 닭 성운', code:'C 100', alt:'IC 2944', con:'센타우루스자리', south:true, mission:'하늘을 달리는 닭을 잡아라', fact:'달리는 닭 모양을 닮아 붙은 별명으로, 내부에서 새 별이 태어나고 있어요.' },
  { id:'rosette', type:'emission', name:'장미 성운', code:'NGC 2237', alt:'Rosette Nebula', con:'외뿔소자리', mission:'우주에 핀 장미를 찾아라', fact:'가운데 구멍은 안쪽 젊은 별들의 강한 항성풍이 가스를 밀어내어 생겼어요.' },
  { id:'runningman', type:'reflection', name:'런닝맨 성운', code:'NGC 1973', alt:'Running Man', con:'오리온자리', mission:'오리온자리에서 달리는 사람을 찾아라', fact:'오리온 대성운 위에 위치하며, 어두운 먼지가 달리는 사람 형태를 만듭니다.' },
  { id:'iris', type:'reflection', name:'아이리스 성운', code:'C 4', alt:'NGC 7023', con:'세페우스자리', mission:'세페우스자리의 붓꽃을 찾아라', fact:'아이리스는 붓꽃을 뜻하며 중앙 밝은 별의 빛을 먼지가 반사해 파랗게 보입니다.' },
  { id:'coalsack', type:'dark', name:'석탄 포대', code:'C 99', alt:'Coalsack', con:'남십자자리', south:true, mission:'은하수에 뚫린 검은 구멍을 찾아라', fact:'남반구에서 맨눈으로도 은하수에 구멍이 뚫린 것처럼 보여요.' },
  { id:'horsehead', type:'dark', name:'말머리 성운', code:'Barnard 33', alt:'Horsehead', con:'오리온자리', mission:'오리온자리의 말 그림자를 찾아라', fact:'뒤쪽 붉은 방출 성운의 빛을 짙은 먼지 구름이 가려 말 머리 모양을 만듭니다.' }
];

const ORDER = ['open','globular','emission','reflection','dark'];
function truth(t){
  return {
    open: { kind:'stars', shape:'scatter', color:'blue' },
    globular: { kind:'stars', shape:'ball', color:'warm' },
    emission: { kind:'cloud', ccolor:'red' },
    reflection: { kind:'cloud', ccolor:'blue' },
    dark: { kind:'cloud', ccolor:'black' }
  }[t];
}

/* Local State */
const KEY = 'mw-hunt-v3';
const CFG = (typeof CONFIG === 'object' && CONFIG) || {};
const GAS = String(CFG.GAS_URL || '').replace(/[“”‘’]/g,'').trim();
const CLASSES = Array.isArray(CFG.CLASSES) && CFG.CLASSES.length ? CFG.CLASSES.map(String) : ['2-1'];
const NTEAMS = +CFG.TEAMS || 8;
const NSTU = +CFG.STUDENTS || 36;

let S = { cls:CLASSES[0], teamNo:'1', num:'', found:{}, quiz:{}, galaxy:{}, queue:[] };
try {
  const raw = localStorage.getItem(KEY);
  if (raw) S = Object.assign(S, JSON.parse(raw));
} catch(e){}
if (!Array.isArray(S.queue)) S.queue = [];
if (!S.galaxy || typeof S.galaxy !== 'object') S.galaxy = {};
let TEACH = false, SAVED = null;

function save(){
  if (TEACH) return;
  try { localStorage.setItem(KEY, JSON.stringify(S)); } catch(e){}
}
const $ = s => document.querySelector(s);
const teamLabel = () => `${S.cls}반`;
const meLabel = () => `${S.cls}반 ${S.num}번`;
const ZONES = [{n:1,t:'open'},{n:2,t:'globular'},{n:3,t:'emission'},{n:4,t:'reflection'},{n:5,t:'dark'}];
const zoneDone = z => OBJ.some(o => o.type === z.t && S.found[o.id]);

let teamRows = [];
let teamStat = { state:'idle', msg:'' };

async function loadTeam(){
  if (!GAS) {
    teamStat = { state:'idle', msg:'내가 찾은 천체가 이 도감에 모여요.' };
    showTeamStat();
    const rb = $('#teamReload'); if (rb) rb.hidden = true;
    return;
  }
  if (!S.num) {
    teamStat = { state:'wait', msg:'번호를 고르면 모둠원 기록을 불러와요.' };
    showTeamStat();
    return;
  }
  try {
    const r = await fetch(`${GAS}?mode=team&cls=${encodeURIComponent(S.cls)}&team=${encodeURIComponent(S.teamNo)}&t=${Date.now()}`, {cache:'no-store'});
    const j = await r.json();
    if (!j.ok) {
      teamStat = { state:'err', msg: j.error==='pin' ? '모둠원 기록을 불러오지 못했습니다.' : `모둠원 기록 로드 실패 (${j.error})` };
      showTeamStat();
      return;
    }
    const latest = {};
    (j.rows || []).map(x => (x.num = String(x.num == null ? '' : x.num).trim(), x)).sort((a,b) => a.ts - b.ts).forEach(x => {
      if (x.kind === 'mission') latest[x.num + '|' + x.id] = x;
    });
    teamRows = Object.values(latest);

    let restored = 0;
    teamRows.filter(x => x.num === String(S.num)).forEach(x => {
      if (/^g[1-4]$/.test(x.id)) {
        if (!S.galaxy[x.id]) { S.galaxy[x.id] = { points: +x.points || 0, restored: true }; restored++; }
        return;
      }
      const o = OBJ.find(k => k.id === x.id);
      if (!o || S.found[x.id]) return;
      const pts = +x.points || 0;
      S.found[x.id] = { points: pts, guess: (o.type === 'milkyway' || pts === 3) ? o.type : null, answers:{}, nick:'', memo:String(x.memo || ''), secs:0, restored:true };
      restored++;
    });
    if (restored) { save(); renderTop(); }
    const others = new Set(teamRows.filter(x => x.num !== String(S.num)).map(x => x.num)).size;
    teamStat = { state:'ok', msg: `${restored ? `내 기록 ${restored}개 복원 · ` : ''}${teamLabel()} 기록 연결됨 · 모둠원 ${others}명 · ${new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})}` };
    renderMissions();
    if (!$('#tab-dex').hidden) renderDex();
    showTeamStat();
  } catch(e) {
    teamStat = { state:'err', msg:'모둠원 기록을 가져오지 못했습니다. 네트워크를 확인해 주세요.' };
    showTeamStat();
  }
}

function showTeamStat(){
  const el = $('#teamStat');
  if (!el) return;
  el.className = 'tstat ' + teamStat.state;
  el.querySelector('span').textContent = teamStat.msg || '모둠원 기록 불러오는 중...';
}
const matesFor = id => teamRows.filter(r => r.id === id && String(r.num) !== String(S.num));
setInterval(loadTeam, 20000);

/* 전송 처리 (Google Apps Script) */
function today(d){ d = d || new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
function send(ev){
  if (TEACH) return;
  ev.uid = Date.now().toString(36) + Math.random().toString(36).slice(2,7);
  ev.ts = Date.now();
  ev.cls = S.cls;
  ev.team = S.teamNo;
  ev.num = S.num;
  S.queue.push(ev);
  save();
  flush();
}

let flushing = false;
async function flush(){
  const pill = $('#syncPill');
  if (TEACH) { pill.className = 'sync'; pill.textContent = '교사 모드'; return; }
  if (!GAS) { pill.className = 'sync'; pill.textContent = '기기 저장 모드'; return; }
  if (flushing || !S.queue.length) {
    if (!S.queue.length) { pill.className = 'sync ok'; pill.textContent = '동기화 완료 ✓'; }
    return;
  }
  flushing = true;
  pill.className = 'sync wait';
  pill.textContent = `전송 중 ${S.queue.length}건`;
  const batch = S.queue.slice(0, 20);
  try {
    const r = await fetch(GAS, { method:'POST', body:JSON.stringify(batch) });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'fail');
    const sent = new Set(batch.map(b => b.uid));
    S.queue = S.queue.filter(q => !sent.has(q.uid));
    save();
    flushing = false;
    if (S.queue.length) flush();
    else { pill.className = 'sync ok'; pill.textContent = '동기화 완료 ✓'; loadTeam(); }
  } catch(e) {
    flushing = false;
    pill.className = 'sync wait';
    pill.textContent = `전송 대기 ${S.queue.length}건`;
  }
}
